PORT=4000
NODE_ENV=development

NOKIA_NAC_BASE_URL=https://network-as-code.p-eu.rapidapi.com
NOKIA_NAC_API_KEY=replace_me
NOKIA_NAC_CLIENT_ID=replace_me
NOKIA_NAC_CLIENT_SECRET=replace_me

ANTHROPIC_API_KEY=replace_me
AGENT_MODEL=claude-sonnet-4-5

# Leave empty for local dev — falls back to in-memory store
DATABASE_URL=

JWT_SECRET=replace_with_a_long_random_string

TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=replace_me   # a real, SMS-capable number on your Twilio account (Console > Phone Numbers) — NOT the WhatsApp sandbox number below
# Twilio's WhatsApp sandbox number for testing (find yours in the Twilio
# console under Messaging > Try it out > Send a WhatsApp message). Format:
# "whatsapp:+14155238886"
TWILIO_WHATSAPP_FROM=

VERIFY_RATE_LIMIT_WINDOW_MS=60000
VERIFY_RATE_LIMIT_MAX=10

# Recruiter self-registration (real 3-legged Number Verification).
# Get these from your Nokia dashboard's Number Verification page — the
# authorize/token URLs and scope may differ slightly from the placeholders
# below depending on your account; confirm before relying on them.
# CAMARA_REDIRECT_URI must be registered in your Nokia app config exactly
# as written here, or Nokia will refuse to redirect back to it.
CAMARA_AUTHORIZE_URL=
CAMARA_REDIRECT_URI=http://localhost:4000/api/recruiter/register/callback
CAMARA_SCOPE=dpv:FraudPreventionAndDetection#number-verification:verify

# Where the backend should send the recruiter's browser back to after a
# registration attempt completes (success or failure)
FRONTEND_BASE_URL=http://localhost:8080
